{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoveraMP Launcher",
  "version": "0.1.0",
  "identifier": "com.noveramp.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoveraMP Launcher",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#1a1a1c",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "NoveraMP multiplayer launcher",
    "category": "Game"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMjRCQUQ5RTgwNkVGN0MKUldSODd3Ym8yYm9rWVhmQjcrRk5ndkZXZk9kQ2FBRFA2SG9wWi9ZTzVIYkRPQWpDUG5rWHAreGQK",
      "endpoints": [
        "https://github.com/NoveraMP/Launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
